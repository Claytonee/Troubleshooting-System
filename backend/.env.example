# ============================================================
# QFT Technical Support System — Environment Variables
# Copy to .env (or .env.{environment}) and fill in values
# ============================================================

# Server
PORT=3000
NODE_ENV=development          # development | staging | testing | production

# Database (MySQL)
# Do NOT set DATABASE_URL as well: it overrides every DB_* var below, and a
# variable set in the hosting panel also overrides this file (dotenv runs
# without override), so a stale connection string here is invisible.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=qft_support

# JWT Authentication
JWT_SECRET=generate-a-strong-random-secret-here
JWT_EXPIRES_IN=7d

# File uploads (100MB)
MAX_FILE_SIZE=104857600

# Cloudinary (file storage CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Chat (optional — Claude via Bedrock)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_token

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Quest Forward Support <support@yourdomain.org>
APP_URL=https://your-app-url

# SMS notifications (optional — Africa's Talking)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Webhook (deployment server only)
WEBHOOK_SECRET=your_github_webhook_secret

# LRS heartbeat (docs/features/01-lrs-heartbeat.md).
# Shared secret the agent on each school LRS sends as X-Heartbeat-Key.
# Unset, POST /api/heartbeat refuses rather than accepting anonymous beats.
# The sweep endpoint reuses WEBHOOK_SECRET above.
HEARTBEAT_KEY=your_heartbeat_key

# WhatsApp intake (docs/features/03-whatsapp-intake.md).
# APP_SECRET signs every inbound webhook and VERIFY_TOKEN completes Meta's
# one-time subscription handshake — without them the webhook refuses rather
# than accepting unauthenticated reports.
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
# Needed only to SEND. Unset, replies are logged and skipped, so the inbound
# half runs and can be tested without a Meta account.
WHATSAPP_TOKEN=your_whatsapp_permanent_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WEBHOOK_PORT=9000
