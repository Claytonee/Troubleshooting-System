# Server
PORT=3000
NODE_ENV=production

# Database (MySQL - use Aiven, PlanetScale, or Railway free tier)
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=qft_support

# JWT
JWT_SECRET=generate-a-strong-random-secret-here
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-app.onrender.com

# Email notifications (optional — leave blank to disable; system runs fine without)
# When all four are set, the app emails on error assign/status/escalation/resolve.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Quest Forward Support <support@yourdomain.org>
APP_URL=https://your-app-url

# SMS notifications (Tier 2 — Africa's Talking; optional)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
