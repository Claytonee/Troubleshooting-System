{
  "1": {
    "duration": 4.182,
    "phrases": [
      {
        "text": "The internet is down.",
        "start": 0.7
      },
      {
        "text": "Can the lesson still run?",
        "start": 2.379
      }
    ]
  },
  "2": {
    "duration": 13.111,
    "phrases": [
      {
        "text": "Your tablet reaches the router over WiFi.",
        "start": 0.3
      },
      {
        "text": "From there, two roads.",
        "start": 3.371
      },
      {
        "text": "One stays inside the school,",
        "start": 5.134
      },
      {
        "text": "to the LRS, where Quest lives.",
        "start": 6.927
      },
      {
        "text": "The other goes out to the internet,",
        "start": 9.433
      },
      {
        "text": "only to sync your work.",
        "start": 11.392
      }
    ]
  },
  "3": {
    "duration": 6.587,
    "phrases": [
      {
        "text": "So when the internet goes down,",
        "start": 0.25
      },
      {
        "text": "the lesson carries on.",
        "start": 2.219
      },
      {
        "text": "Work waits,",
        "start": 3.918
      },
      {
        "text": "and syncs later.",
        "start": 5.068
      }
    ]
  },
  "4": {
    "duration": 9.311,
    "phrases": [
      {
        "text": "But if the LRS stops answering,",
        "start": 0.25
      },
      {
        "text": "nothing loads.",
        "start": 2.427
      },
      {
        "text": "Check its power light,",
        "start": 3.977
      },
      {
        "text": "its cable at the switch,",
        "start": 5.545
      },
      {
        "text": "then Quest on a tablet.",
        "start": 7.291
      }
    ]
  },
  "5": {
    "duration": 8.196,
    "phrases": [
      {
        "text": "Still nothing?",
        "start": 0.25
      },
      {
        "text": "Don't unplug it.",
        "start": 1.493
      },
      {
        "text": "Report it as critical:",
        "start": 2.943
      },
      {
        "text": "no LRS, no lesson.",
        "start": 4.593
      }
    ]
  }
}